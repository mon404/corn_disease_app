#:import FitImage kivymd.uix.fitimage.FitImage


<WelcomeScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: [0.96, 0.97, 0.96, 1] # Light gray-green background

        # Top App Bar
        MDTopAppBar:
            title: "Corn Leaf Disease"
            anchor_title: "left"
            elevation: 2
            md_bg_color: [0.1, 0.27, 0.12, 1] # Forest Green
            specific_text_color: [1, 1, 1, 1]
            left_action_items: [["leaf", lambda x: None]]
            right_action_items: [["menu", lambda x: None]]

        MDScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(20)
                adaptive_height: True

                # Welcome Card
                MDCard:
                    orientation: 'vertical'
                    padding: dp(24)
                    spacing: dp(12)
                    radius: [20, 20, 20, 20]
                    elevation: 1
                    md_bg_color: [1, 1, 1, 1]
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Selamat Datang!"
                        font_style: "H4"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: [0.1, 0.27, 0.12, 1] # Forest Green
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Aplikasi Klasifikasi\nPenyakit Daun Jagung"
                        font_style: "H5"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: [0.15, 0.15, 0.15, 1]
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Aplikasi ini menggunakan metode CNN dan MobileNetV2 untuk mengklasifikasikan penyakit pada daun jagung."
                        font_style: "Body1"
                        halign: "center"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # Leaf Image Card
                MDCard:
                    size_hint_y: None
                    height: dp(220)
                    radius: [20, 20, 20, 20]
                    elevation: 0
                    md_bg_color: [0.9, 0.94, 0.9, 1]
                    
                    FitImage:
                        source: "assets/corn_leaf.jpg"
                        radius: [20, 20, 20, 20]
                        allow_stretch: True

                # Start Prediction Button
                MDRaisedButton:
                    text: "   Mulai Prediksi   "
                    icon: "leaf"
                    font_size: "18sp"
                    md_bg_color: [0.1, 0.27, 0.12, 1] # Forest Green
                    theme_text_color: "Custom"
                    text_color: [1, 1, 1, 1]
                    size_hint_x: 0.9
                    pos_hint: {"center_x": 0.5}
                    height: dp(54)
                    radius: [27, 27, 27, 27]
                    on_release: app.root.current = 'predict'

                # Info Footer Card
                MDCard:
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [15, 15, 15, 15]
                    elevation: 0.5
                    md_bg_color: [0.93, 0.95, 0.93, 1]
                    size_hint_y: None
                    height: self.minimum_height

                    MDBoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDIcon:
                            icon: "information-outline"
                            theme_text_color: "Custom"
                            text_color: [0.1, 0.27, 0.12, 1]
                            size_hint: (None, None)
                            size: (dp(24), dp(24))

                        MDLabel:
                            text: "Aplikasi ini dapat mengklasifikasikan 4 kelas penyakit:"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: [0.2, 0.3, 0.2, 1]
                            bold: True
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDBoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(50)
                        pos_hint: {"center_x": 0.5}

                        # Blight
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(2)
                            MDIcon:
                                icon: "leaf-off"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]
                            MDLabel:
                                text: "Blight"
                                font_style: "Caption"
                                halign: "center"
                                font_size: "9sp"

                        # Common Rust
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(2)
                            MDIcon:
                                icon: "blur"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]
                            MDLabel:
                                text: "Common Rust"
                                font_style: "Caption"
                                halign: "center"
                                font_size: "9sp"

                        # Gray Leaf Spot
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(2)
                            MDIcon:
                                icon: "texture-box"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]
                            MDLabel:
                                text: "Gray Spot"
                                font_style: "Caption"
                                halign: "center"
                                font_size: "9sp"

                        # Healthy
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(2)
                            MDIcon:
                                icon: "check-decagram"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]
                            MDLabel:
                                text: "Healthy"
                                font_style: "Caption"
                                halign: "center"
                                font_size: "9sp"


<PredictionScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: [0.96, 0.97, 0.96, 1]

        # Top App Bar
        MDTopAppBar:
            title: "Prediksi Penyakit"
            anchor_title: "left"
            elevation: 0
            md_bg_color: [0.1, 0.27, 0.12, 1]
            specific_text_color: [1, 1, 1, 1]
            left_action_items: [["arrow-left", lambda x: setattr(app.root, 'current', 'welcome')]]
            right_action_items: [["help-circle-outline", lambda x: None]]


        MDScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(16)
                adaptive_height: True

                # Step 1 Title
                MDLabel:
                    text: "1. Unggah Gambar Daun Jagung"
                    font_style: "Subtitle1"
                    bold: True
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: self.texture_size[1]

                # Upload Area Card (Clickable)
                MDCard:
                    size_hint_y: None
                    height: dp(200)
                    radius: [15, 15, 15, 15]
                    shadow_radius: [15, 15, 15, 15]
                    elevation: 1
                    md_bg_color: [1, 1, 1, 1]
                    on_release: root.open_image_source_dialog()



                    # Nested layout for upload prompt or image preview
                    MDBoxLayout:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(10)
                        gravity: "center"
                        
                        # Show upload layout if no image selected
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(8)
                            opacity: 1 if not root.selected_image_path else 0
                            size_hint_y: 1 if not root.selected_image_path else None
                            height: self.minimum_height if not root.selected_image_path else 0

                            MDIcon:
                                icon: "cloud-upload-outline"
                                font_size: "48sp"
                                halign: "center"
                                pos_hint: {"center_x": 0.5}
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]

                            MDLabel:
                                text: "Klik untuk unggah gambar\natau pilih file dari HP"
                                font_style: "Body1"
                                halign: "center"
                                theme_text_color: "Primary"
                                bold: True

                            MDLabel:
                                text: "Format: JPG, PNG (Maks. 5MB)"
                                font_style: "Caption"
                                halign: "center"
                                theme_text_color: "Secondary"

                        # Show preview image if selected
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(4)
                            opacity: 1 if root.selected_image_path else 0
                            size_hint_y: 1 if root.selected_image_path else None
                            height: self.minimum_height if root.selected_image_path else 0

                            FitImage:
                                source: root.selected_image_path if root.selected_image_path else "assets/corn_leaf.jpg"
                                radius: [10, 10, 10, 10]
                                size_hint_y: 0.9

                            MDLabel:
                                text: "Gambar Terpilih: " + (root.selected_image_path.split('\\')[-1] if '\\' in root.selected_image_path else root.selected_image_path.split('/')[-1] if root.selected_image_path else "")
                                font_style: "Caption"
                                halign: "center"
                                theme_text_color: "Secondary"
                                size_hint_y: 0.1

                # Step 2 Title
                MDLabel:
                    text: "2. Pilih Model Klasifikasi"
                    font_style: "Subtitle1"
                    bold: True
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: self.texture_size[1]

                # Model Selection Layout
                MDBoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(100)

                    # Card MobileNetV2
                    MDCard:
                        id: card_mobilenet
                        orientation: 'vertical'
                        padding: dp(12)
                        spacing: dp(4)
                        radius: [12, 12, 12, 12]
                        shadow_radius: [12, 12, 12, 12]
                        elevation: 0.5
                        md_bg_color: [0.88, 0.95, 0.88, 1] # Selected by default
                        on_release: root.select_model_type("mobilenet")


                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(24)
                            MDIcon:
                                icon: "connection"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1]
                            MDIcon:
                                icon: "check-circle"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1] if root.selected_model == "mobilenet" else [0,0,0,0]
                                pos_hint: {"right": 1}

                        MDLabel:
                            text: "MobileNetV2"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: [0.1, 0.27, 0.12, 1]
                        MDLabel:
                            text: "(Transfer Learning)"
                            font_style: "Caption"
                            theme_text_color: "Secondary"

                    # Card Custom CNN
                    MDCard:
                        id: card_cnn
                        orientation: 'vertical'
                        padding: dp(12)
                        spacing: dp(4)
                        radius: [12, 12, 12, 12]
                        shadow_radius: [12, 12, 12, 12]
                        elevation: 0.5
                        md_bg_color: [1, 1, 1, 1]
                        on_release: root.select_model_type("cnn")


                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(24)
                            MDIcon:
                                icon: "chart-scatter-plot"
                                theme_text_color: "Secondary"
                            MDIcon:
                                icon: "check-circle"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.27, 0.12, 1] if root.selected_model == "cnn" else [0,0,0,0]
                                pos_hint: {"right": 1}

                        MDLabel:
                            text: "CNN"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "(Convolutional NN)"
                            font_style: "Caption"
                            theme_text_color: "Secondary"

                # Info/Keterangan card
                MDCard:
                    orientation: 'horizontal'
                    padding: dp(16)
                    spacing: dp(10)
                    radius: [12, 12, 12, 12]
                    shadow_radius: [12, 12, 12, 12]
                    elevation: 0
                    md_bg_color: [1, 0.97, 0.9, 1] # Light gold/yellow background
                    size_hint_y: None
                    height: self.minimum_height

                    MDIcon:
                        icon: "lightbulb-on-outline"
                        theme_text_color: "Custom"
                        text_color: [0.8, 0.5, 0.0, 1]
                        size_hint: (None, None)
                        size: (dp(24), dp(24))

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDLabel:
                            text: "Keterangan"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: [0.8, 0.5, 0.0, 1]
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            id: label_keterangan
                            text: "MobileNetV2 umumnya memberikan akurasi lebih tinggi dan komputasi lebih efisien."
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: [0.4, 0.3, 0.2, 1]
                            size_hint_y: None
                            height: self.texture_size[1]

                # Prediction execution button
                MDRaisedButton:
                    text: "   Proses Prediksi   "
                    icon: "magnify"
                    font_size: "18sp"
                    md_bg_color: [0.1, 0.27, 0.12, 1] # Forest green
                    theme_text_color: "Custom"
                    text_color: [1, 1, 1, 1]
                    size_hint_x: 0.95
                    pos_hint: {"center_x": 0.5}
                    height: dp(50)
                    radius: [10, 10, 10, 10]
                    shadow_radius: [10, 10, 10, 10]
                    on_release: root.process_prediction()



<ResultScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: [0.96, 0.97, 0.96, 1]

        # Top App Bar
        MDTopAppBar:
            title: "Hasil Klasifikasi"
            anchor_title: "left"
            elevation: 2
            md_bg_color: [0.1, 0.27, 0.12, 1]
            specific_text_color: [1, 1, 1, 1]
            left_action_items: [["arrow-left", lambda x: setattr(app.root, 'current', 'predict')]]
            right_action_items: [["home-outline", lambda x: setattr(app.root, 'current', 'welcome')]]

        MDScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(14)
                adaptive_height: True

                # Success notification banner
                MDCard:
                    orientation: 'horizontal'
                    padding: dp(12)
                    spacing: dp(8)
                    radius: [10, 10, 10, 10]
                    elevation: 0
                    md_bg_color: [0.9, 0.95, 0.9, 1]
                    size_hint_y: None
                    height: self.minimum_height

                    MDIcon:
                        icon: "check-circle"
                        theme_text_color: "Custom"
                        text_color: [0.1, 0.27, 0.12, 1]
                        size_hint: (None, None)
                        size: (dp(24), dp(24))

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDLabel:
                            text: "Prediksi Selesai"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: "Berikut adalah hasil klasifikasi gambar Anda."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # Main Result Box Card (Side by Side style)
                MDCard:
                    orientation: 'horizontal'
                    padding: dp(16)
                    spacing: dp(16)
                    radius: [15, 15, 15, 15]
                    elevation: 1
                    md_bg_color: [1, 1, 1, 1]
                    size_hint_y: None
                    height: dp(160)

                    # Image thumbnail
                    MDCard:
                        size_hint: (0.45, 1)
                        radius: [10, 10, 10, 10]
                        elevation: 0
                        
                        FitImage:
                            source: root.image_path if root.image_path else "assets/corn_leaf.jpg"
                            radius: [10, 10, 10, 10]

                    # Info text on the right
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_x: 0.55
                        gravity: "center_vertical"

                        MDLabel:
                            text: "Prediksi Utama"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: root.pred_class
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Confidence"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: root.pred_confidence
                            font_style: "Subtitle1"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Model: " + root.model_name
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # Probabilities Section
                MDCard:
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [15, 15, 15, 15]
                    elevation: 0.5
                    md_bg_color: [1, 1, 1, 1]
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Probabilitas Tiap Kelas"
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    # Class 1: Blight
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(20)
                            MDLabel:
                                text: "Blight"
                                font_style: "Body2"
                                theme_text_color: "Primary"
                            MDLabel:
                                text: root.prob_blight_pct
                                font_style: "Body2"
                                halign: "right"
                                bold: True

                        MDProgressBar:
                            value: root.prob_blight
                            color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: dp(6)

                    # Class 2: Common Rust
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(20)
                            MDLabel:
                                text: "Common Rust"
                                font_style: "Body2"
                                theme_text_color: "Primary"
                            MDLabel:
                                text: root.prob_rust_pct
                                font_style: "Body2"
                                halign: "right"
                                bold: True

                        MDProgressBar:
                            value: root.prob_rust
                            color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: dp(6)

                    # Class 3: Gray Leaf Spot
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(20)
                            MDLabel:
                                text: "Gray Leaf Spot"
                                font_style: "Body2"
                                theme_text_color: "Primary"
                            MDLabel:
                                text: root.prob_gray_pct
                                font_style: "Body2"
                                halign: "right"
                                bold: True

                        MDProgressBar:
                            value: root.prob_gray
                            color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: dp(6)

                    # Class 4: Healthy
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(20)
                            MDLabel:
                                text: "Healthy"
                                font_style: "Body2"
                                theme_text_color: "Primary"
                            MDLabel:
                                text: root.prob_healthy_pct
                                font_style: "Body2"
                                halign: "right"
                                bold: True

                        MDProgressBar:
                            value: root.prob_healthy
                            color: [0.15, 0.45, 0.18, 1] # Slightly brighter green for healthy
                            size_hint_y: None
                            height: dp(6)

                # Field warning/recommendation info
                MDCard:
                    orientation: 'horizontal'
                    padding: dp(14)
                    spacing: dp(10)
                    radius: [12, 12, 12, 12]
                    elevation: 0
                    md_bg_color: [0.93, 0.95, 0.93, 1]
                    size_hint_y: None
                    height: self.minimum_height

                    MDIcon:
                        icon: "information-outline"
                        theme_text_color: "Custom"
                        text_color: [0.1, 0.27, 0.12, 1]
                        size_hint: (None, None)
                        size: (dp(24), dp(24))

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        size_hint_y: None
                        height: self.minimum_height
                        
                        MDLabel:
                            text: "Informasi"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: [0.1, 0.27, 0.12, 1]
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: "Hasil prediksi hanya sebagai rekomendasi. Lakukan pengecekan lebih lanjut di lapangan."
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: [0.2, 0.3, 0.2, 1]
                            size_hint_y: None
                            height: self.texture_size[1]

                # Bottom Actions Button (Repeat & Save)
                MDBoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(48)

                    # Re-upload / Predict Again Button (outlined style)
                    MDRaisedButton:
                        text: "Unggah Ulang"
                        icon: "upload"
                        size_hint_x: 0.5
                        height: dp(48)
                        md_bg_color: [0.9, 0.9, 0.9, 1]
                        theme_text_color: "Custom"
                        text_color: [0.1, 0.27, 0.12, 1]
                        radius: [8, 8, 8, 8]
                        on_release: app.root.current = 'predict'

                    # Save predictions button
                    MDRaisedButton:
                        text: "Simpan Hasil"
                        icon: "content-save"
                        size_hint_x: 0.5
                        height: dp(48)
                        md_bg_color: [0.1, 0.27, 0.12, 1]
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1]
                        radius: [8, 8, 8, 8]
                        on_release: root.save_results()
